---
import { formatMarker } from '../core/template/sentinels.ts'
import { listOf, valueOf } from './template.ts'

// In template mode `when` is a sentinel, which the marker carries.
const { when } = Astro.props
const value = valueOf(when)
if (listOf(when))
  throw new Error('gratis: <If> over a list is not supported yet; use a field')
---

{value ? (
  <>
    <Fragment set:html={formatMarker({ kind: 'if', value })} />
    <slot />
    <Fragment set:html={formatMarker({ kind: 'end', of: 'if' })} />
  </>
) : when ? (
  <slot />
) : null}
