---
import { ifBlock } from './template-mode.ts'

// Its content when `when` is truthy; in the template pass, always, between markers.
const { when } = Astro.props
const block = ifBlock(when)
---

{block ? (
  <>
    <Fragment set:html={block.start} />
    <slot />
    <Fragment set:html={block.end} />
  </>
) : when ? (
  <slot />
) : null}
