---
import { markerOf } from './template.ts'

// In template mode `when` is a sentinel; the marker carries its scope and field.
const { when } = Astro.props
const ref = markerOf(when)
---

{ref ? (
  <>
    <Fragment set:html={`<!--gratis:if ${ref}-->`} />
    <slot />
    <Fragment set:html="<!--/gratis:if-->" />
  </>
) : when ? (
  <slot />
) : null}
