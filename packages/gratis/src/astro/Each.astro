---
import { eachBlock } from './template-mode.ts'

// Once per item; in the template pass, once for a placeholder item, between
// markers.
const { of } = Astro.props
const block = eachBlock(of)
const items = block ? block.items : (of ?? [])
const rendered = await Promise.all(
  items.map((item) => Astro.slots.render('default', [item])),
)
---

{block && <Fragment set:html={block.start} />}
<Fragment set:html={rendered.join('')} />
{block && <Fragment set:html={block.end} />}
