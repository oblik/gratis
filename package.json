{
  "name": "gratis-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "tsc -p e2e && playwright install --only-shell chromium && vitest run --dir e2e",
    "setup:aws": "node --env-file=.env scripts/setup-aws.js",
    "setup:editor": "node --env-file=.env scripts/create-editor.js",
    "deploy": "pnpm --filter gratis build && node --env-file=.env packages/gratis/src/astro/cli.ts deploy --bucket demo.gratis.build --root examples/basic",
    "setup:cloudflare": "node --env-file=.env scripts/setup-cloudflare.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@aws-sdk/client-iam": "^3.1154.0",
    "@aws-sdk/client-s3": "^3.1154.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.6.5",
    "aws4fetch": "^1.0.20",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
