{
  "name": "gratis-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "setup:aws": "node --env-file=.env scripts/setup-aws.js",
    "setup:editor": "node --env-file=.env scripts/create-editor.js",
    "deploy": "pnpm --filter gratis build && node --env-file=.env packages/gratis/src/astro/cli.js deploy --bucket demo.gratis.build --root examples/basic",
    "setup:cloudflare": "node --env-file=.env scripts/setup-cloudflare.js"
  },
  "devDependencies": {
    "@aws-sdk/client-iam": "^3.1154.0",
    "@aws-sdk/client-s3": "^3.1154.0",
    "aws4fetch": "^1.0.20",
    "jsdom": "^30.1.3"
  }
}
